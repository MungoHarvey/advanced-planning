{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "Glob(*)",
      "Grep(*)",
      "TodoWrite",
      "TodoRead",
      "WebSearch",
      "WebFetch(*)",
      "Agent(*)",
      "Write(.advanced-plans/**)",
      "Edit(.advanced-plans/**)",
      "MultiEdit(.advanced-plans/**)",
      "Read(.advanced-plans/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .advanced-plans/logs && echo \"\\n=== SESSION START $(date '+%Y-%m-%d %H:%M:%S') model:${CLAUDE_MODEL:-unknown} ===\" >> .advanced-plans/logs/execution.log"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"=== SESSION END $(date '+%Y-%m-%d %H:%M:%S') ===\" >> .advanced-plans/logs/execution.log"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] AGENT START: ${CLAUDE_AGENT_NAME:-unknown} model:${CLAUDE_MODEL:-unknown}\" >> .advanced-plans/logs/execution.log"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] AGENT STOP:  ${CLAUDE_AGENT_NAME:-unknown}\" >> .advanced-plans/logs/execution.log"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python platforms/claude-code/hooks/precompact_handoff_check.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .advanced-plans/state/planning-mode ]; then case \"${CLAUDE_TOOL_INPUT_PATH:-}\" in *.advanced-plans/*) ;; *) echo 'BLOCK: Write disabled during planning mode. Allowed: .advanced-plans/ only.' >&2; exit 2 ;; esac; fi"
          },
          {
            "type": "command",
            "command": "if [ -f .advanced-plans/state/gate-review-mode ]; then case \"${CLAUDE_TOOL_INPUT_PATH:-}\" in *.advanced-plans/*) ;; *) echo 'BLOCK: Write disabled during gate review mode. Allowed: .advanced-plans/ only.' >&2; exit 2 ;; esac; fi"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .advanced-plans/state/planning-mode ]; then case \"${CLAUDE_TOOL_INPUT_PATH:-}\" in *.advanced-plans/*) ;; *) echo 'BLOCK: Edit disabled during planning mode. Allowed: .advanced-plans/ only.' >&2; exit 2 ;; esac; fi"
          },
          {
            "type": "command",
            "command": "if [ -f .advanced-plans/state/gate-review-mode ]; then case \"${CLAUDE_TOOL_INPUT_PATH:-}\" in *.advanced-plans/*) ;; *) echo 'BLOCK: Edit disabled during gate review mode. Allowed: .advanced-plans/ only.' >&2; exit 2 ;; esac; fi"
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .advanced-plans/state/planning-mode ]; then case \"${CLAUDE_TOOL_INPUT_PATH:-}\" in *.advanced-plans/*) ;; *) echo 'BLOCK: MultiEdit disabled during planning mode. Allowed: .advanced-plans/ only.' >&2; exit 2 ;; esac; fi"
          },
          {
            "type": "command",
            "command": "if [ -f .advanced-plans/state/gate-review-mode ]; then case \"${CLAUDE_TOOL_INPUT_PATH:-}\" in *.advanced-plans/*) ;; *) echo 'BLOCK: MultiEdit disabled during gate review mode. Allowed: .advanced-plans/ only.' >&2; exit 2 ;; esac; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] TODOS UPDATED\" >> .advanced-plans/logs/execution.log"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] BASH: exit:${CLAUDE_TOOL_RESULT_EXIT_CODE:-?}\" >> .advanced-plans/logs/execution.log"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] WRITE: ${CLAUDE_TOOL_INPUT_PATH:-unknown}\" >> .advanced-plans/logs/execution.log"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] EDIT:  ${CLAUDE_TOOL_INPUT_PATH:-unknown}\" >> .advanced-plans/logs/execution.log"
          }
        ]
      }
    ]
  }
}
